# Audio
persist.audio.device=dac
persist.audio.hdmi.device=vc4hdmi0
persist.audio.pcm.card.auto=true
ro.config.media_vol_default=20
ro.config.media_vol_steps=25
ro.hardware.audio.primary=rpi_hdmi

# Bluetooth - head-unit (car) mode
bluetooth.device.class_of_device=38,4,8
bluetooth.device.default_name=Raspberry Pi 5
bluetooth.framework.adapter_address_validation=true
bluetooth.framework.support_persisted_state=false
bluetooth.gatt.check_encrypted_link.enabled=false
# Head-unit profiles (enable)
bluetooth.profile.a2dp.sink.enabled=true
bluetooth.profile.avrcp.controller.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.hf.enabled=true
bluetooth.profile.pbap.client.enabled=true
# Phone/source profiles (disable)
bluetooth.profile.a2dp.source.enabled=false
bluetooth.profile.avrcp.target.enabled=false
bluetooth.profile.hfp.ag.enabled=false
bluetooth.profile.map.client.enabled=true
bluetooth.profile.map.server.enabled=false
bluetooth.profile.opp.enabled=false
bluetooth.profile.pan.nap.enabled=false
bluetooth.profile.pan.panu.enabled=false
bluetooth.profile.pbap.server.enabled=false
bluetooth.profile.sap.server.enabled=false

# Camera
ro.hardware.camera=libcamera

# CEC
persist.hdmi.cec_device=cec0
ro.hdmi.device_type=4

# Chipset
ro.soc.manufacturer=Broadcom
ro.soc.model=BCM2712

# Display
debug.drm.mode.force=1920x1080

# FFmpeg
persist.ffmpeg_codec2.rank.audio=16
persist.ffmpeg_codec2.rank.video=256
persist.ffmpeg_codec2.v4l2.h265=true

# Graphics
ro.hardware.egl=mesa
ro.hardware.hwcomposer=drm
ro.hardware.vulkan=broadcom
ro.opengles.version=196609
ro.vendor.hwc.drm.use_config_groups=0
vendor.hwc.backend_override=rpi5
vendor.hwc.drm.ctm=DRM_OR_IGNORE

# Lockscreen
ro.lockscreen.disable.default=true

# Media
debug.stagefright.c2inputsurface=-1

# MGLRU
persist.device_config.mglru_native.lru_gen_config=core

# Storage
persist.sys.fuse.backup.external_volume_backup=false

# USB
sys.usb.controller=1000480000.usb

# Wifi
wifi.interface=wlan0

# Window extensions
persist.settings.large_screen_opt.enabled=true
